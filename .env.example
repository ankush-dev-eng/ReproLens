# ReproLens Environment Configuration Example
# Copy to .env and fill in real values. Never commit .env to version control!

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
REPROLENS_MODEL=anthropic/claude-3.5-sonnet
REPROLENS_FALLBACK_MODELS=google/gemini-2.0-flash-exp,openai/gpt-4o-mini

# Optional GitHub Token (to increase REST API rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Sandbox & Execution Backend
# Auto-detected: 'docker' if Docker daemon is responsive, else 'demo'
REPROLENS_EXECUTION_MODE=auto

# Optional Remote Runner URL (only if a real remote sandbox is hosted)
REPROLENS_REMOTE_RUNNER_URL=

# SQLite Database Location (defaults to reprolens.db in project root)
REPROLENS_DB_PATH=reprolens.db

# Cache LLM responses in SQLite (true/false)
REPROLENS_CACHE_LLM=true
